# --- Database (Postgres, 예: Supabase/Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/lunchtime"

# --- Naver Cloud Platform Maps ---
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID="your-ncp-maps-client-id"

# --- Gemini API (packinbag과는 별도 키/프로젝트 권장) ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Auth ---
# 회사코드+닉네임+PIN 세션 서명용 시크릿
SESSION_SECRET="change-me"

# --- Firebase (선택: 별도 프로젝트로 새로 생성 권장) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
