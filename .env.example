# --- Firebase (Firestore) - packinbag과는 별도 프로젝트로 새로 생성 권장 ---
# 클라이언트용 config (Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정에서 확인)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# 서버(Admin SDK)용 - 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은 JSON을
# 한 줄 문자열로 그대로 넣기 (줄바꿈 포함된 private_key도 JSON 문자열이라 문제 없음)
FIREBASE_SERVICE_ACCOUNT_KEY='{"project_id":"...","client_email":"...","private_key":"..."}'

# --- Naver Cloud Platform Maps ---
# Client ID는 브라우저에 그대로 노출되는 값이라 NEXT_PUBLIC_로 둬도 안전 (지도 스크립트 URL에 원래 포함됨)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID="your-ncp-maps-client-id"
# Client Secret은 서버에서 Geocoding/Reverse Geocoding 호출할 때만 사용 (X-NCP-APIGW-API-KEY 헤더).
# 절대 NEXT_PUBLIC_ 접두사 붙이지 말 것 - 붙이면 브라우저로 노출됨.
NAVER_MAP_CLIENT_SECRET="your-ncp-maps-client-secret"

# NCP 콘솔 > Application Services > Maps > Style Editor에서 발행한 커스텀 지도 스타일 ID.
# 식당 마커가 많이 쌓여서 기본 지도의 POI 아이콘/상호명 라벨 등을 꺼서 단순화할 때 쓴다.
# 이 값이 비어있으면(아직 스타일을 안 만들었으면) 자동으로 기본(일반) 지도로 폴백된다.
NEXT_PUBLIC_NAVER_MAP_STYLE_ID=""

# --- Gemini API (packinbag과는 별도 키/프로젝트 권장) ---
GEMINI_API_KEY="your-gemini-api-key"

# --- 공공데이터포털(data.go.kr) 소상공인시장진흥공단_상가(상권)정보 API ---
# scripts/seed-restaurants-opendata.ts용. data.go.kr에서 "소상공인시장진흥공단_상가(상권)정보"
# 서비스를 신청하면 발급되는 인증키 중 "일반 인증키(Decoding)" 값을 그대로 넣을 것
# (Encoding 값을 넣으면 이중 인코딩되어 요청이 실패함).
DATA_GO_KR_SERVICE_KEY="your-data-go-kr-decoding-service-key"

# --- Auth ---
# 회사코드+닉네임+PIN 세션 서명용 시크릿
SESSION_SECRET="change-me"
